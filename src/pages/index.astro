---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import MobileBar from '../components/layout/MobileBar.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero/Hero.astro';
import Packages from '../components/sections/Packages/Packages.astro';
import Quote from '../components/sections/Quote/Quote.astro';
import Results from '../components/sections/Results/Results.astro';
