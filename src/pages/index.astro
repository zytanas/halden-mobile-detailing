---
import Layout from '../layouts/Layout.astro';

const services = [
	{ name: 'Exterior Detail', text: 'Hand wash, clay bar, and wax for a deep, lasting shine.' },
	{ name: 'Interior Detail', text: 'Vacuum, steam clean, and conditioning for every surface.' },
	{ name: 'Full Detail', text: 'Inside and out, done right at your driveway.' },
];
---

<Layout>
	<main>
		<section class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
			<p data-hero class="mb-4 text-sm font-semibold uppercase tracking-widest text-sky-400">
				Mobile Detailing
			</p>
			<h1 data-hero class="max-w-3xl text-5xl font-bold tracking-tight md:text-7xl">
				Halden Mobile Detailing
			</h1>
			<p data-hero class="mt-6 max-w-xl text-lg text-neutral-400">
				Showroom shine, delivered to your door.
			</p>
			<a
				data-hero
				href="#services"
				class="mt-10 rounded-full bg-sky-500 px-8 py-3 font-semibold text-neutral-950 transition hover:bg-sky-400"
			>
				See services
			</a>
		</section>

		<section id="services" class="mx-auto grid max-w-5xl gap-6 px-6 py-24 md:grid-cols-3">
			{services.map((s) => (
				<article data-reveal class="rounded-2xl border border-neutral-800 bg-neutral-900 p-8">
					<h2 class="text-xl font-semibold">{s.name}</h2>
					<p class="mt-3 text-neutral-400">{s.text}</p>
				</article>
			))}
		</section>
	</main>
</Layout>

<script>
	import '../scripts/animations';
</script>
