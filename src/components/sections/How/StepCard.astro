---
import Icon from '../../ui/Icon.astro';
import type { HowStep } from '../../../content/how';

type Props = HowStep;

const { number, icon, title, text, meta, metaIcon } = Astro.props;

/*
 * Geometry comes from custom properties set on the steps wrapper in How.astro
 * (--step-pad, --step-num, --step-num-box, --step-line-x, --step-line-y), so the node and
 * number always line up with the progress line drawn there.
 *
 * The card is positioned but creates no stacking context, so the progress line (later in the
 * DOM) paints over its background, and the z-1 content paints over the line. The outlined
 * number has no fill, so the line shows through it.
 *
 * Starts active (line drawn) for no-JS and reduced motion; how.animation.ts toggles data-active.
 */
---

<li
	class="step group/step metal-card relative grid grid-cols-[var(--step-num-box)_1fr] grid-rows-[auto_1fr] gap-x-4 rounded-xl p-(--step-pad) md:grid-cols-[auto_1fr]"
	data-how-step
	data-active
>
	<!-- Node where the line crosses the card edge: top edge on mobile, left edge from md -->
	<span
		class="absolute top-[-0.5px] left-(--step-line-x) z-1 size-3 -translate-1/2 rounded-full border-2 border-line bg-surface transition-colors duration-500 ease-out group-data-active/step:border-accent group-data-active/step:bg-accent motion-reduce:transition-none md:top-(--step-line-y) md:left-[-0.5px]"
		aria-hidden="true"
		data-how-node></span>

	<!-- The list is an <ol>, so the visual number is hidden from assistive tech -->
	<span class="step-number heading relative z-1 text-center md:text-left" aria-hidden="true">{number}</span>

	<!-- Centred on the digits' optical middle, so the progress line runs through it on desktop -->
	<span
		class="relative z-1 mt-[calc(var(--step-num)*var(--step-num-mid)-1.5rem)] grid size-12 place-items-center self-start justify-self-end rounded-full border border-line bg-surface text-ink ring-accent/20 transition-shadow duration-500 ease-out group-data-active/step:ring-4 motion-reduce:transition-none"
	>
		<Icon name={icon} class="size-5" />
	</span>

	<div class="relative z-1 col-start-2 mt-2 flex flex-col md:col-span-2 md:col-start-1 md:mt-8 lg:mt-10">
		<h3 class="heading text-card-title text-ink">{title}</h3>
		<p class="mt-3 text-ink-muted">{text}</p>
		<div class="mt-auto pt-6">
			<p
				class="inline-flex items-center gap-2 rounded-lg border border-line bg-metal-100/80 py-1.5 pr-3.5 pl-2.5 text-[0.8125rem] leading-snug font-medium text-ink"
			>
				<Icon name={metaIcon} class="size-3.5 shrink-0 text-accent-deep" />
				{meta}
			</p>
		</div>
	</div>
</li>

<style>
	/* Line box = font size, so the number's centre is predictable for the progress line */
	.step-number {
		font-size: var(--step-num);
		line-height: 1;
		color: var(--color-ink-muted);
		transition:
			color var(--duration-slow) var(--ease-out),
			-webkit-text-stroke-color var(--duration-slow) var(--ease-out);
	}

	.step[data-active] .step-number {
		color: var(--color-accent);
	}

	@supports (-webkit-text-stroke: 1px) {
		.step-number,
		.step[data-active] .step-number {
			color: transparent;
			-webkit-text-stroke: 1.5px var(--color-ink);
		}

		.step[data-active] .step-number {
			-webkit-text-stroke-color: var(--color-accent);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.step-number {
			transition: none;
		}
	}
</style>
