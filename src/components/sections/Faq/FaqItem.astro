---
import Icon from '../../ui/Icon.astro';
import { answerParts, type Faq } from '../../../content/faq';

interface Props {
	faq: Faq;
	/** Shared by every item, so the browser keeps only one open (no-JS) */
	name: string;
	open?: boolean;
}

const { faq, name, open = false } = Astro.props;
const questionId = `faq-${faq.id}-question`;
const answerId = `faq-${faq.id}-answer`;

/*
 * Ships as <details>/<summary>, so every answer works without JavaScript. Faq.astro's script
 * rebuilds each item as an h3 > button controlling a region, copying the attributes across,
 * so every state style here is written twice: `open:` for details, `data-open:` once enhanced.
 * The open item's red edge is an inset shadow, which follows the rounded corners.
 */
---

<details
	name={name}
	open={open}
	class="group/faq rounded-lg border border-line bg-surface shadow-[inset_0_0_0_0_var(--color-accent)] transition-[background-color,box-shadow] duration-400 ease-out open:bg-metal-100 open:shadow-[inset_3px_0_0_0_var(--color-accent)] data-open:bg-metal-100 data-open:shadow-[inset_3px_0_0_0_var(--color-accent)] motion-reduce:transition-none"
	data-faq-item
>
	<summary
		id={questionId}
		class="flex w-full cursor-pointer list-none items-center justify-between gap-5 rounded-lg px-5 py-4.5 text-left text-lg leading-snug font-medium text-ink transition-colors duration-400 ease-out group-open/faq:text-accent-deep group-data-open/faq:text-accent-deep hover:text-accent-deep focus-visible:-outline-offset-2 motion-reduce:transition-none sm:px-6 [&::-webkit-details-marker]:hidden"
		data-faq-question
	>
		<span>{faq.question}</span>
		<span
			class="grid size-8 shrink-0 place-items-center rounded-pill border border-line bg-metal-200 text-ink transition-[background-color,border-color,color] duration-400 ease-out group-open/faq:border-accent group-open/faq:bg-accent group-open/faq:text-on-accent group-data-open/faq:border-accent group-data-open/faq:bg-accent group-data-open/faq:text-on-accent motion-reduce:transition-none"
		>
			<Icon
				name="plus"
				class="size-4 transition-[rotate] duration-400 ease-out group-open/faq:rotate-45 group-data-open/faq:rotate-45 motion-reduce:transition-none"
			/>
		</span>
	</summary>

	<div id={answerId} data-faq-panel>
		<p class="max-w-[60ch] px-5 pb-6 text-ink-muted sm:px-6 sm:pr-16" data-faq-answer>
			{
				answerParts(faq.answer).map((part) =>
					part.href ? (
						<a
							href={part.href}
							class="font-medium text-accent-deep underline decoration-1 underline-offset-[0.2em] transition-[text-decoration-thickness] hover:decoration-2"
						>
							{part.text}
						</a>
					) : (
						part.text
					),
				)
			}
		</p>
	</div>
</details>
