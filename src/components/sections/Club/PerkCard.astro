---
import Icon from '../../ui/Icon.astro';
import { formatPerkValue, type ClubPerk } from '../../../content/club';

type Props = ClubPerk & { class?: string };

const { value, title, text, condition, featured, badge, class: className } = Astro.props;
const final = formatPerkValue(value);

/*
 * DOM order is title first so heading navigation lands on the perk name; flex order
 * puts the badge and the big value above it visually.
 */
---

<li
	class:list={[
		'flex flex-col rounded-xl p-6 lg:p-5 xl:p-7',
		featured ? 'bg-accent text-on-accent shadow-accent' : 'metal-card text-ink',
		className,
	]}
	data-club-perk
>
	{
		badge && (
			<span class="order-first mb-4 self-start rounded-pill bg-on-accent px-3 py-1 text-xs font-semibold text-accent-deep">
				{badge}
			</span>
		)
	}

	<h3 class="mt-3 text-sm font-semibold tracking-[0.08em] uppercase">{title}</h3>

	<p class:list={['heading -order-1 text-stat', featured ? 'text-on-accent' : 'text-accent']}>
		<span class="sr-only">{final}</span>
		{/*
			Final value in the HTML for no-JS; the animation counts up to it. The invisible copy
			holds the final width so the card never reflows while counting.
		*/}
		<span class="inline-grid tabular-nums" aria-hidden="true">
			<span class="invisible col-start-1 row-start-1">{final}</span>
			<span
				class="col-start-1 row-start-1"
				data-count-to={value.amount}
				data-prefix={value.prefix}
				data-suffix={value.suffix}>{final}</span
			>
		</span>
	</p>

	<p class:list={['mt-2 text-[0.9375rem] leading-normal', featured ? 'text-on-accent' : 'text-ink-muted']}>{text}</p>

	<p class="mt-auto flex items-center gap-2 pt-6 text-[0.8125rem] leading-snug font-medium">
		<Icon name="check" class:list={['size-3.5 shrink-0', featured ? 'text-on-accent' : 'text-accent-deep']} />
		{condition}
	</p>
</li>
