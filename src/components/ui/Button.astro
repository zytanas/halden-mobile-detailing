---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import { buttonClass, type ButtonSize, type ButtonVariant } from './button';

/** A link by default; pass `type` instead of `href` for a form <button>. Classes live in button.ts. */
type Props = Omit<HTMLAttributes<'a'>, 'type'> & {
	variant?: ButtonVariant;
	size?: ButtonSize;
} & ({ href: string; type?: never } | { href?: never; type: 'submit' | 'button' });

const { href, type, variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;

const Tag = href === undefined ? 'button' : 'a';
---

<Tag href={href} type={type} class:list={[buttonClass({ variant, size }), className]} {...rest}>
	<slot />
	{
		variant === 'link' && (
			<Icon
				name="arrow"
				class="size-4 transition-transform duration-500 ease-out group-hover:translate-x-1.5 group-focus-visible:translate-x-1.5"
			/>
		)
	}
</Tag>
