---
import { site } from '../../config/site';
import { navigation } from '../../content/navigation';
import logomark from '../../assets/images/logo/halden-logomark.svg';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<a
	href="#top"
	class:list={[
		'inline-flex items-center gap-2.5 rounded-sm text-ink transition-opacity duration-300 hover:opacity-80',
		className,
	]}
	aria-label={`${site.name}, ${navigation.homeLabel}`}
	data-logo
>
	<img
		src={logomark.src}
		width={logomark.width}
		height={logomark.height}
		alt=""
		aria-hidden="true"
		decoding="async"
		class="h-6 w-auto"
	/>
	<span class="text-sm font-semibold tracking-logo uppercase">{site.shortName}</span>
</a>
