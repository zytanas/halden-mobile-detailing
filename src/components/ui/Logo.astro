---
import { site } from '../../config/site';
import { navigation } from '../../content/navigation';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<a
	href="#top"
	class:list={[
		'inline-flex items-center gap-2.5 rounded-sm text-ink transition-opacity duration-300 hover:opacity-80',
		className,
	]}
	aria-label={`${site.name}, ${navigation.homeLabel}`}
	data-logo
>
	<!-- Red droplet mark -->
	<svg class="h-5 w-auto text-accent" viewBox="0 0 14 20" fill="none" aria-hidden="true">
		<path
			d="M7 1.25C7 1.25 1.5 8 1.5 12.25a5.5 5.5 0 0 0 11 0C12.5 8 7 1.25 7 1.25Z"
			stroke="currentColor"
			stroke-width="1.25"
			stroke-linejoin="round"></path>
		<path d="M4.5 12.5a2.6 2.6 0 0 0 2.25 2.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"
		></path>
	</svg>
	<span class="text-sm font-semibold tracking-logo uppercase">{site.shortName}</span>
</a>
