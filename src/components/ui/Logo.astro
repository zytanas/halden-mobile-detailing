---
import { site } from '../../config/site';
import { navigation } from '../../content/navigation';
import logomark from '../../assets/images/logo/halden-logomark.svg';

interface Props {
	/** "light" for dark backgrounds (footer): the mark is turned white with a filter */
	tone?: 'ink' | 'light';
	class?: string;
}

const { tone = 'ink', class: className } = Astro.props;
const light = tone === 'light';
---

<a
	href="#top"
	class:list={[
		'inline-flex items-center gap-2.5 rounded-sm transition-opacity duration-300 hover:opacity-80',
		light ? 'text-on-accent' : 'text-ink',
		className,
	]}
	aria-label={`${site.name}, ${navigation.homeLabel}`}
	data-logo
>
	<img
		src={logomark.src}
		width={logomark.width}
		height={logomark.height}
		alt=""
		aria-hidden="true"
		decoding="async"
		class:list={['h-6 w-auto', light && 'brightness-0 invert']}
	/>
	<span class="text-sm font-semibold tracking-logo uppercase">{site.shortName}</span>
</a>
