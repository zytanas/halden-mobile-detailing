---
/** Small line icons on a 16px grid. Decorative by default (aria-hidden). Paths live in icons.ts. */
import { iconPaths, iconViewBox, type IconName } from './icons';

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className = 'size-4' } = Astro.props;
---

<svg class={className} viewBox={iconViewBox(name)} fill="none" aria-hidden="true">
	<path d={iconPaths[name]} stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"
	></path>
</svg>
