---
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource-variable/inter-tight/wght.css';
import '../styles/global.css';

// Preload the latin subsets used above the fold so the hero headline swaps in quickly
import displayUrl from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import sansUrl from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';

import { site } from '../config/site';

interface Props {
	title?: string;
	description?: string;
}

const { title = `${site.name} · ${site.tagline}`, description = site.description } = Astro.props;
const fontPreloads = [displayUrl, sansUrl];
// Social apps need absolute URLs; `site` is set in astro.config.mjs
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.jpg', Astro.site);
---

<!doctype html>
<html lang={site.locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="color-scheme" content="light" />
		<meta name="theme-color" content={site.themeColor} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content={site.locale.replace('-', '_')} />
		<meta property="og:url" content={canonicalUrl} />
		<link rel="canonical" href={canonicalUrl} />
		<!-- Link-share preview card. Generated: npm run og-image -->
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
		<meta name="twitter:card" content="summary_large_image" />
		<!-- Generated from the logomark: npm run favicons -->
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		{fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			// JS is running: reveal targets may start hidden (see global.css). Failsafe: if the
			// reveal script hasn't taken over within 4s, show everything as it is.
			(function () {
				var d = document.documentElement;
				d.classList.add('js');
				setTimeout(function () {
					d.classList.add('reveal-ready');
				}, 4000);
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<script>
	import { initScroll } from '../lib/scroll';
	import { initReveal } from '../lib/reveal';

	initScroll();
	initReveal();
</script>
